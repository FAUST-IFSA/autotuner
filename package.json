{
  "name": "autotuner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-assets.mjs",
    "pretest": "node scripts/make-fixture.mjs --if-missing",
    "test": "vitest run",
    "licenses:check": "node scripts/licenses-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@spotify/basic-pitch": "1.0.1",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "idb-keyval": "6.3.0",
    "konva": "^10.7.1",
    "pitchy": "4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.3",
    "react-konva": "^19.3.0",
    "signalsmith-stretch": "1.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "license-checker-rseidelsohn": "5.0.1",
    "oxlint": "^1.81.0",
    "prettier": "3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@tensorflow/tfjs": "4.22.0"
  }
}
